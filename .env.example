# Copia este archivo a .env.local y rellena con los valores de tu proyecto

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: NUNCA con NEXT_PUBLIC_, solo se usa en el servidor (webhook de Stripe)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=
# Stripe (dashboard.stripe.com -> Developers -> Webhooks -> tu endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=

# La URL pública de tu web (usada para las redirecciones tras el pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
